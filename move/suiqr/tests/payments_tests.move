// ─── Test: double-claim same UEN fails ─────────────────────────────────

#[test]
#[expected_failure(abort_code = 1, location = suiqr::payments)] // E_UEN_ALREADY_CLAIMED
fun double_claim_uen_fails() {
    let mut scenario = ts::begin(ADMIN);
    setup_registry(&mut scenario);
    init_issuer(&mut scenario, ISSUER_PUBKEY, TEST_CHAIN_ID);

    // First claim — real vector, succeeds
    ts::next_tx(&mut scenario, MERCHANT);
    {
        let mut registry = ts::take_shared<MerchantRegistry>(&mut scenario);
        let clock = new_clock_at(1000, ts::ctx(&mut scenario));
        payments::register_merchant(
            &mut registry,
            TEST_UEN,
            TEST_NONCE,
            TEST_SIGNATURE,
            TEST_EXPIRES_AT_MS,
            option::none(),
            &clock,
            ts::ctx(&mut scenario),
        );
        clock::destroy_for_testing(clock);
        ts::return_shared(registry);
    };

    // Second claim of same UEN — should abort with E_UEN_ALREADY_CLAIMED
    // Use a different nonce so we hit the UEN_ALREADY check, not nonce-replay.
    ts::next_tx(&mut scenario, MERCHANT);
    let mut registry = ts::take_shared<MerchantRegistry>(&mut scenario);
    let clock = new_clock_at(2000, ts::ctx(&mut scenario));
    let other_nonce = vector[1u8, 2u8, 3u8, 4u8, 5u8, 6u8, 7u8, 8u8, 9u8, 10u8, 11u8, 12u8, 13u8, 14u8, 15u8, 16u8, 17u8, 18u8, 19u8, 20u8, 21u8, 22u8, 23u8, 24u8, 25u8, 26u8, 27u8, 28u8, 29u8, 30u8, 31u8, 32u8];

    payments::register_merchant(
        &mut registry,
        TEST_UEN,
        other_nonce,
        TEST_SIGNATURE, // sig won't verify but UEN check fires first
        TEST_EXPIRES_AT_MS,
        option::none(),
        &clock,
        ts::ctx(&mut scenario),
    );

    clock::destroy_for_testing(clock);
    ts::return_shared(registry);
    ts::end(scenario);
}

// ─── Test: pay happy path ──────────────────────────────────────────────

#[test]
fun pay_succeeds_and_emits_receipt() {
    let mut scenario = ts::begin(ADMIN);
    setup_registry(&mut scenario);

    // Use test bypass to register (we exercise register path in other tests)
    ts::next_tx(&mut scenario, ADMIN);
    {
        let mut registry = ts::take_shared<MerchantRegistry>(&mut scenario);
        let clock = new_clock_at(1000, ts::ctx(&mut scenario));
        payments::register_for_testing(
            &mut registry,
            TEST_UEN,
            MERCHANT,
            &clock,
            ts::ctx(&mut scenario),
        );
        clock::destroy_for_testing(clock);
        ts::return_shared(registry);
    };

    // Payer pays 1_000_000 mist (= 0.001 SUI) — small ticket
    ts::next_tx(&mut scenario, PAYER);
    let registry = ts::take_shared<MerchantRegistry>(&mut scenario);
    let clock = new_clock_at(2000, ts::ctx(&mut scenario));
    let coin: Coin<SUI> = coin::mint_for_testing<SUI>(1_000_000, ts::ctx(&mut scenario));

    payments::pay<SUI>(
        &registry,
        TEST_UEN,
        coin,
        option::some(b"chicken rice"),
        150, // SGD $1.50 minor units
        option::some(b"quote-meta-bcs-bytes"),
        &clock,
        ts::ctx(&mut scenario),
    );

    clock::destroy_for_testing(clock);
    ts::return_shared(registry);

    // Verify merchant received the coin
    ts::next_tx(&mut scenario, MERCHANT);
    let received = ts::take_from_sender<Coin<SUI>>(&mut scenario);
    assert!(coin::value(&received) == 1_000_000, 0);
    ts::return_to_sender(&mut scenario, received);

    ts::end(scenario);
}

