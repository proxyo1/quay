// ─── Test: issuer pubkey rotation via AdminCap ─────────────────────────

#[test]
fun rotate_issuer_pubkey_succeeds() {
    let mut scenario = ts::begin(ADMIN);
    setup_registry(&mut scenario);
    init_issuer(&mut scenario, ISSUER_PUBKEY, TEST_CHAIN_ID);

    ts::next_tx(&mut scenario, ADMIN);
    let cap = ts::take_from_sender<AdminCap>(&mut scenario);
    let mut registry = ts::take_shared<MerchantRegistry>(&mut scenario);
    let clock = new_clock_at(5000, ts::ctx(&mut scenario));

    let new_key = vector[9u8, 9u8, 9u8, 9u8, 9u8, 9u8, 9u8, 9u8, 9u8, 9u8, 9u8, 9u8, 9u8, 9u8, 9u8, 9u8, 9u8, 9u8, 9u8, 9u8, 9u8, 9u8, 9u8, 9u8, 9u8, 9u8, 9u8, 9u8, 9u8, 9u8, 9u8, 9u8];
    payments::rotate_issuer_pubkey(&cap, &mut registry, new_key, &clock);
    assert!(payments::issuer_pubkey(&registry) == new_key, 0);

    clock::destroy_for_testing(clock);
    ts::return_to_sender(&mut scenario, cap);
    ts::return_shared(registry);
    ts::end(scenario);
}

