// ─── Test: update_merchant_address — owner only ────────────────────────

#[test]
fun update_merchant_address_by_owner_succeeds() {
    let mut scenario = ts::begin(ADMIN);
    setup_registry(&mut scenario);

    ts::next_tx(&mut scenario, ADMIN);
    {
        let mut registry = ts::take_shared<MerchantRegistry>(&mut scenario);
        let clock = new_clock_at(1000, ts::ctx(&mut scenario));
        payments::register_for_testing(&mut registry, TEST_UEN, MERCHANT, &clock, ts::ctx(&mut scenario));
        clock::destroy_for_testing(clock);
        ts::return_shared(registry);
    };

    ts::next_tx(&mut scenario, MERCHANT);
    let mut registry = ts::take_shared<MerchantRegistry>(&mut scenario);
    let clock = new_clock_at(2000, ts::ctx(&mut scenario));

    payments::update_merchant_address(&mut registry, TEST_UEN, OTHER_MERCHANT, &clock, ts::ctx(&mut scenario));
    assert!(payments::merchant_address(&registry, TEST_UEN) == OTHER_MERCHANT, 0);

    clock::destroy_for_testing(clock);
    ts::return_shared(registry);
    ts::end(scenario);
}

#[test]
#[expected_failure(abort_code = 3, location = suiqr::payments)] // E_NOT_MERCHANT_OWNER
fun update_merchant_address_by_non_owner_fails() {
    let mut scenario = ts::begin(ADMIN);
    setup_registry(&mut scenario);

