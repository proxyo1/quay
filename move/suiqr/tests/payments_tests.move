// ─── Test: uen_hash includes domain tag ────────────────────────────────

#[test]
fun uen_hash_differs_from_raw_hash() {
    // The registry key is blake2b256(b"PAYNOW_UEN_V1" || uen) and must differ
    // from blake2b256(uen) alone — otherwise the future PAYNOW_MOBILE_V1
    // namespace could collide with PAYNOW_UEN_V1.
    let raw_uen = TEST_UEN;
    let domain_keyed = payments::derive_uen_hash_for_testing(raw_uen);
    let raw_hash = sui::hash::blake2b256(&raw_uen);
    assert!(domain_keyed != raw_hash, 0);
    // vector<u8> has drop — no explicit destroy needed
}

// ─── Test: chain_id reads back ─────────────────────────────────────────

#[test]
fun chain_id_persists_across_calls() {
    let mut scenario = ts::begin(ADMIN);
