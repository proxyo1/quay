// ─── REGRESSION (D9 #1): old-shape attestation rejected by new contract ─

/// CRITICAL — proves the new contract refuses to verify a signature made
/// against the OLD ClaimMessage shape (without evidence_hash). Without this
/// check, an attacker who held a pre-migration attestation could register
/// under the new contract without producing any evidence. The BCS shape
/// change is itself a security boundary.
#[test]
#[expected_failure(abort_code = 5, location = quay::payments)] // E_INVALID_ATTESTATION
fun register_old_shape_attestation_rejected() {
    let mut scenario = ts::begin(ADMIN);
    setup_registry(&mut scenario);
    init_issuer(&mut scenario, ISSUER_PUBKEY, TEST_CHAIN_ID);

    ts::next_tx(&mut scenario, MERCHANT);
    let mut registry = ts::take_shared<MerchantRegistry>(&mut scenario);
    let clock = new_clock_at(1000, ts::ctx(&mut scenario));

    payments::register_merchant(
        &mut registry,
        TEST_UEN,
        TEST_NONCE,
        OLD_SHAPE_SIGNATURE, // signature over BCS(ClaimMessage_v1, no evidence_hash)
        TEST_EXPIRES_AT_MS,
        option::none(),
        TEST_EVIDENCE_HASH,
        &clock,
        ts::ctx(&mut scenario),
    );

    clock::destroy_for_testing(clock);
    ts::return_shared(registry);
    ts::end(scenario);
}

// ─── REGRESSION (D9 #2): pay works on new MerchantEntry shape ──────────

/// CRITICAL — register via the real-signature path (exercising the new
/// uen_raw + evidence_hash fields on MerchantEntry) and then pay against
/// it. Verifies the new entry shape doesn't break the pay flow.
#[test]
fun pay_works_after_real_register_with_evidence() {
    let mut scenario = ts::begin(ADMIN);
    setup_registry(&mut scenario);
    init_issuer(&mut scenario, ISSUER_PUBKEY, TEST_CHAIN_ID);

    // Real register with evidence_hash
    ts::next_tx(&mut scenario, MERCHANT);
    {
        let mut registry = ts::take_shared<MerchantRegistry>(&mut scenario);
        let clock = new_clock_at(1000, ts::ctx(&mut scenario));
        payments::register_merchant(
            &mut registry,
            TEST_UEN,
            TEST_NONCE,
            TEST_SIGNATURE,
            TEST_EXPIRES_AT_MS,
            option::some(string::utf8(b"walrus-blob-xyz")),
            TEST_EVIDENCE_HASH,
            &clock,
            ts::ctx(&mut scenario),
        );
        clock::destroy_for_testing(clock);
        ts::return_shared(registry);
    };

    // Pay against the freshly-shaped entry
    ts::next_tx(&mut scenario, PAYER);
    let registry = ts::take_shared<MerchantRegistry>(&mut scenario);
    let clock = new_clock_at(2000, ts::ctx(&mut scenario));
    let coin: Coin<SUI> = coin::mint_for_testing<SUI>(500_000, ts::ctx(&mut scenario));

    payments::pay<SUI>(
        &registry,
        TEST_UEN,
        coin,
        option::some(b"latte"),
        450, // S$4.50
        option::some(b"v2-quote-metadata-bcs"),
        &clock,
        ts::ctx(&mut scenario),
    );

    clock::destroy_for_testing(clock);
    ts::return_shared(registry);

    // Merchant received it
    ts::next_tx(&mut scenario, MERCHANT);
    let received = ts::take_from_sender<Coin<SUI>>(&mut scenario);
    assert!(coin::value(&received) == 500_000, 0);
    ts::return_to_sender(&mut scenario, received);

    ts::end(scenario);
}

// ─── REGRESSION (D9 #3): evidence_hash mismatch fails signature check ──

/// CRITICAL — the issuer signs over a specific evidence_hash. If a merchant
/// submits a register tx with a DIFFERENT evidence_hash than the one signed,
/// the BCS message differs and ed25519 verification fails. This is what makes
/// evidence binding non-theatrical: you can't swap evidence post-signing.
#[test]
#[expected_failure(abort_code = 5, location = quay::payments)] // E_INVALID_ATTESTATION
fun register_with_wrong_evidence_hash_fails() {
    let mut scenario = ts::begin(ADMIN);
    setup_registry(&mut scenario);
    init_issuer(&mut scenario, ISSUER_PUBKEY, TEST_CHAIN_ID);

    ts::next_tx(&mut scenario, MERCHANT);
    let mut registry = ts::take_shared<MerchantRegistry>(&mut scenario);
    let clock = new_clock_at(1000, ts::ctx(&mut scenario));

    // 32 zero bytes — definitely not what the issuer signed over.
    let wrong_evidence = vector[0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8];

    payments::register_merchant(
        &mut registry,
        TEST_UEN,
        TEST_NONCE,
        TEST_SIGNATURE, // valid sig but over TEST_EVIDENCE_HASH (not zeros)
        TEST_EXPIRES_AT_MS,
        option::none(),
        wrong_evidence,
        &clock,
        ts::ctx(&mut scenario),
    );

    clock::destroy_for_testing(clock);
    ts::return_shared(registry);
    ts::end(scenario);
}
