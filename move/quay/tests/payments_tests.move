// ─── Helpers ───────────────────────────────────────────────────────────

fun new_clock_at(t_ms: u64, ctx: &mut TxContext): Clock {
    let mut c = clock::create_for_testing(ctx);
    clock::set_for_testing(&mut c, t_ms);
    c
}

fun setup_registry(scenario: &mut ts::Scenario) {
    ts::next_tx(scenario, ADMIN);
    payments::init_for_testing(ts::ctx(scenario));
}

fun init_issuer(scenario: &mut ts::Scenario, pubkey: vector<u8>, chain_id: u8) {
    ts::next_tx(scenario, ADMIN);
    let mut registry = ts::take_shared<MerchantRegistry>(scenario);
    payments::set_initial_issuer_pubkey(&mut registry, pubkey, chain_id, ts::ctx(scenario));
    ts::return_shared(registry);
}

// ─── Test: happy-path register with real ed25519 vector ────────────────

#[test]
fun register_merchant_happy_path_real_signature() {
    let mut scenario = ts::begin(ADMIN);
    setup_registry(&mut scenario);
    init_issuer(&mut scenario, ISSUER_PUBKEY, TEST_CHAIN_ID);

    ts::next_tx(&mut scenario, MERCHANT);
    let mut registry = ts::take_shared<MerchantRegistry>(&mut scenario);
    let clock = new_clock_at(1000, ts::ctx(&mut scenario));

    payments::register_merchant(
        &mut registry,
        TEST_UEN,
        TEST_NONCE,
        TEST_SIGNATURE,
        TEST_EXPIRES_AT_MS,
        option::some(string::utf8(b"walrus-blob-id-deadbeef")),
        TEST_EVIDENCE_HASH,
        &clock,
        ts::ctx(&mut scenario),
    );

    assert!(payments::is_registered(&registry, TEST_UEN), 0);
    assert!(payments::merchant_address(&registry, TEST_UEN) == MERCHANT, 1);

    clock::destroy_for_testing(clock);
    ts::return_shared(registry);
    ts::end(scenario);
}

